# ==============================
# Web dashboard security
# ==============================
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_THIS_PASSWORD
FLASK_SECRET_KEY=GENERATE_A_LONG_RANDOM_VALUE
CONTROL_SECRET=GENERATE_ANOTHER_LONG_RANDOM_VALUE

# Public URL of this controller, with NO trailing slash.
# Example: https://subtitle-bot-control.onrender.com
PUBLIC_BASE_URL=https://YOUR-CONTROLLER-DOMAIN.example

# ==============================
# Kaggle authentication
# ==============================
# Compatibility method used by the Kaggle CLI: values from kaggle.json
KAGGLE_USERNAME=YOUR_KAGGLE_USERNAME
KAGGLE_KEY=YOUR_KAGGLE_API_KEY

# Newer Kaggle CLI installations may also accept KAGGLE_API_TOKEN.
# Leave blank if you are using KAGGLE_USERNAME + KAGGLE_KEY.
KAGGLE_API_TOKEN=

# Dedicated PRIVATE Kaggle worker kernel used by this controller.
# Example: vktheencoder/subtitle-bot-controller-worker
KAGGLE_KERNEL_REF=YOUR_KAGGLE_USERNAME/subtitle-bot-controller-worker
KAGGLE_KERNEL_TITLE=Subtitle Bot Controller Worker

# IMPORTANT:
# Leave blank if you want Kaggle to preserve the accelerator already configured
# for this worker kernel in Kaggle UI (recommended after setting GPU T4 x2 once).
# If you want the CLI to explicitly request an accelerator, use a Kaggle-supported ID,
# e.g. NvidiaTeslaT4. Your current bot expects TWO GPUs, so verify the actual allocation.
KAGGLE_ACCELERATOR=

# Optional controller settings
KAGGLE_PUSH_TIMEOUT_SECONDS=300
KAGGLE_STATUS_POLL_SECONDS=12
WORKER_HEARTBEAT_STALE_SECONDS=45
DEFAULT_AUTO_STOP_MINUTES=120

# Flask / hosting
# Keep 1 on HTTPS hosting. Change to 0 only for local http://127.0.0.1 testing.
COOKIE_SECURE=1
PORT=5000
STATE_FILE=/tmp/subtitle_bot_controller_state.json

# === FIXED V2: runtime bot credentials stored on Render ===
# API-pushed Kaggle versions do not reliably inherit Kaggle UI User Secrets.
# The controller securely bootstraps these values to the private Kaggle worker.
GITHUB_TOKEN=
API_ID=
API_HASH=
BOT_TOKEN=
ALLOWED_USER_ID=
OPENAI_API_KEY=
ADMIN_IDS=
CHANNEL_MAP=
LEECH_URL=

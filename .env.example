# ==============================
# Web dashboard security
# ==============================
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_THIS_PASSWORD
FLASK_SECRET_KEY=GENERATE_A_LONG_RANDOM_VALUE
CONTROL_SECRET=GENERATE_ANOTHER_LONG_RANDOM_VALUE

# Public HTTPS Render URL, NO trailing slash.
PUBLIC_BASE_URL=https://YOUR-CONTROLLER-DOMAIN.example

# ==============================
# Kaggle authentication (shared by both bots)
# ==============================
KAGGLE_USERNAME=YOUR_KAGGLE_USERNAME
KAGGLE_KEY=YOUR_KAGGLE_API_KEY
# Or use the newer token form instead of username/key:
KAGGLE_API_TOKEN=

# ==============================
# BOT 1: Subtitle Gen
# ==============================
# New names. Existing KAGGLE_KERNEL_REF / KAGGLE_KERNEL_TITLE / KAGGLE_ACCELERATOR
# are still accepted as fallbacks, so your working deployment does not have to break.
SUBTITLE_KAGGLE_KERNEL_REF=YOUR_KAGGLE_USERNAME/subtitle-bot-controller-worker
SUBTITLE_KAGGLE_KERNEL_TITLE=Subtitle Bot Controller Worker
SUBTITLE_KAGGLE_ACCELERATOR=

# ==============================
# BOT 2: Encoding Bot
# ==============================
# MUST be a different Kaggle kernel slug from the Subtitle bot.
ENCODING_KAGGLE_KERNEL_REF=YOUR_KAGGLE_USERNAME/encoding-bot-controller-worker
ENCODING_KAGGLE_KERNEL_TITLE=Encoding Bot Controller Worker
ENCODING_KAGGLE_ACCELERATOR=NvidiaTeslaT4

# These defaults match the uploaded encoding notebook.
ENCODING_REPO_OWNER=VkTheEncoder
ENCODING_REPO_NAME=Queue3-GPU
ENCODING_BOT_ENTRYPOINT=muxbot.py

# Optional separate GitHub token for Queue3-GPU.
# Leave blank to reuse GITHUB_TOKEN below.
ENCODING_GITHUB_TOKEN=

# ==============================
# Controller timing / hosting
# ==============================
KAGGLE_PUSH_TIMEOUT_SECONDS=300
KAGGLE_STATUS_POLL_SECONDS=12
WORKER_HEARTBEAT_STALE_SECONDS=45
DEFAULT_AUTO_STOP_MINUTES=120
COOKIE_SECURE=1
PORT=5000
STATE_FILE=/tmp/kaggle_multi_bot_controller_state.json

# ==============================
# Existing Subtitle bot runtime credentials on Render
# ==============================
# GITHUB_TOKEN is ALSO reused to clone Queue3-GPU unless ENCODING_GITHUB_TOKEN is set.
GITHUB_TOKEN=
API_ID=
API_HASH=
BOT_TOKEN=
ALLOWED_USER_ID=
OPENAI_API_KEY=
ADMIN_IDS=
CHANNEL_MAP=
LEECH_URL=
